# Neon Database URL
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 32-byte hex encryption key for AES-256-GCM
ENCRYPTION_KEY=""

# NextAuth Configuration
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# AI Platform Fallback Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
EMBEDDING_API_KEY=""

# Local LLM Integration (Ollama / Self-Hosted)
OPENAI_BASE_URL="http://127.0.0.1:11434/v1"
OPENAI_MODEL="oneai-qwen"

# Meta (Facebook / Instagram) App Credentials
NEXT_PUBLIC_META_APP_ID=""
META_APP_SECRET=""

# LinkedIn OAuth 2.0 Credentials
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Campaign Worker Configuration
WORKER_POLL_MS=""
WORKER_PER_LOOP_CAP=""
WORKER_CONCURRENCY=""
WORKER_STALE_LOCK_MS=""
MAX_CSV_IMPORT_ROWS=""

# Email tracking & compliance (E7)
# Required. Random value of at least 32 characters, used only to sign open, click and unsubscribe links.
# Generate with: openssl rand -hex 32
EMAIL_TRACKING_SECRET=""
# Signing secret of the platform-wide Resend account's webhook (whsec_...).
# Tenants with their own provider account save their secret in Settings > Email instead.
RESEND_WEBHOOK_SECRET=""

# Verify token for Meta webhooks (WhatsApp and Instagram). Choose any long random text (16+ characters)
# and type the same value in the Meta app's webhook settings. There is no default: without it Meta
# cannot verify the webhook.
META_WEBHOOK_VERIFY_TOKEN=
